# Florapeutic Content Studio — local API keys
# ------------------------------------------------------------------
# 1. Copy this file to ".env.local"  (cp .env.local.example .env.local)
# 2. Paste your keys after the "=" signs (no quotes, no spaces).
# 3. Restart the dev server (Ctrl+C, then `npm run dev`) — Vite only
#    reads env files at startup.
#
# These load automatically so you don't retype keys each session. The
# Settings panel still overrides them if you type a key there.
#
# SECURITY: .env.local is gitignored and stays on your machine. Don't
# share the built site (dist/) publicly — Vite bundles VITE_ vars into it.
#
# NOTE: In this project the browser no longer calls OpenAI directly. Audio
# transcription and enhancement happen through the local backend so the
# secret key stays server-side.
# ------------------------------------------------------------------

# Transcription (audio -> script). platform.openai.com -> API keys
VITE_OPENAI_KEY=

# Script enhancement ("Enhance with AI"). console.anthropic.com -> API keys
VITE_ANTHROPIC_KEY=

# Creative video. Paste as  keyid:secret  (both halves, colon between).
# Use a key from the Higgsfield account that HAS your credits.
VITE_HIGGSFIELD_KEY=

# Optional talking-head presenter. heygen.com -> Settings -> API
VITE_HEYGEN_KEY=
